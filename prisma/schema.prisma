generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String   @id @default(cuid())
  clerkOrgId             String   @unique
  name                   String
  phone                  String   @default("")
  intro                  String   @default("")
  /** Immutable tenant owner email (invited at creation). */
  ownerEmail             String   @default("")
  /** Filled when the owner accepts the Clerk org invite. */
  ownerClerkUserId       String?  @unique
  chatLanguage           String   @default("multi")
  idleResetDays          Int      @default(5)
  mediaAnalysisEnabled   Boolean  @default(false)
  hookmyappWorkspaceId   String?
  zernioProfileId        String?  @unique
  /** IANA timezone for the daily digest clock. */
  timezone               String   @default("Asia/Jerusalem")
  digestEnabled          Boolean  @default(false)
  digestHour             Int      @default(8)
  /** Digest template sector ("general" | "hospitality" | "appointments"); "" = infer from capabilities. */
  digestSector           String   @default("")
  /** Instant WhatsApp alerts to digest recipients when a lead needs the owner now. */
  alertsEnabled          Boolean  @default(false)
  alertApprovals         Boolean  @default(true)
  alertHandoffs          Boolean  @default(true)
  /** Off hours in the tenant timezone; `quietStartHour` > `quietEndHour` spans midnight. */
  quietHoursEnabled      Boolean  @default(true)
  quietStartHour         Int      @default(22)
  quietEndHour           Int      @default(8)
  /** What an alert does in off hours: "hold" = send when they end, "digest" = leave it to the daily digest. */
  quietMode              String   @default("hold")
  /** When false, agent never replies (inbound still persists). */
  agentRepliesEnabled    Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  agents               Agent[]
  capabilityInstances  CapabilityInstance[]
  channelConnections   ChannelConnection[]
  leads                Lead[]
  conversations        Conversation[]
  messages             Message[]
  hitlTasks            HitlTask[]
  requests             Request[]
  adminDecisionLogs    AdminDecisionLog[]
  mediaAssets          MediaAsset[]
  revisions            AgentConfigRevision[]
  pendingTeamInvites   TeamPendingInvite[]
  leadStageEvents      LeadStageEvent[]
  leadNotes            LeadNote[]
  digestRecipients     DigestRecipient[]
  digestLogs           DigestLog[]
  rapidDemos           RapidDemo[]
}

/**
 * One configured request type for a tenant: "the villa's stay flow", "the dress
 * shop's fitting flow". Onboarding a business type is a row here, not a column on
 * Tenant and not new code - one tenant can run several instances at once.
 */
model CapabilityInstance {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /** Registered capability that runs this instance: "booking" | "reservations". */
  capabilityId String
  /** Tenant-facing kind, also the `Request.kind`: "visit" | "stay" | "fitting" | … */
  kind         String
  enabled      Boolean  @default(true)
  /** Field schema, nouns, templates, availability provider, policies. */
  config       Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, kind])
  @@index([tenantId, capabilityId])
}

/** Local pending invites when Clerk org invitations are unavailable (e.g. *.vercel.app). */
model TeamPendingInvite {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  role      String
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@index([email])
}

model Agent {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  catalogId            String   @default("inbox")
  systemPrompt         String   @default("")
  knowledgeText        String   @default("")
  persona              Json     @default("{}")
  flow                 Json
  flowVersion          Int      @default(1)
  flowChangedAt        DateTime @default(now())
  leadSchema           Json
  leadSchemaVersion    Int      @default(1)
  leadSchemaChangedAt  DateTime @default(now())
  hitlPolicy           Json
  mediaAnalysis        Boolean  @default(false)
  n8nWebhookUrl        String?
  calcomEventTypeId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  channelConnections ChannelConnection[]
  conversations      Conversation[]
  revisions          AgentConfigRevision[]

  @@index([tenantId])
}

model AgentConfigRevision {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind      String
  version   Int
  payload   Json
  savedBy   String?
  savedAt   DateTime @default(now())

  @@index([agentId, kind, version])
}

model ChannelConnection {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId            String
  agent              Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider           String
  providerAccountId  String
  providerExternalId String? @map("hookmyappChannelId")
  apiBase            String   @default("https://gateway.hookmyapp.com/meta")
  accessTokenEnc     String
  hmacSecretEnc      String
  verifyToken        String
  enabled            Boolean  @default(true)
  /** When false, agent never replies on this channel (inbound still persists). */
  agentRepliesEnabled Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  leads         Lead[]
  conversations Conversation[]

  @@unique([provider, providerAccountId])
  @@index([tenantId])
}

model Lead {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelId      String
  channel        ChannelConnection @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalUserId String
  displayName    String?
  status         String   @default("open")
  /** Admin has not opened / marked this lead as read. */
  adminUnread    Boolean  @default(true)
  fields         Json     @default("{}")
  /** Sales pipeline position (new → talking → … → won). Not the bot's `Conversation.flowState`. */
  pipelineStage          String    @default("new")
  /** auto | manual */
  pipelineStageSource    String    @default("auto")
  pipelineStageReason    String    @default("")
  pipelineStageChangedAt DateTime  @default(now())
  /** Why the owner should act now: handoff | approval | reminder | cold. Not the bot's auto-nudge. */
  attentionReason        String?
  attentionAt            DateTime?
  snoozedUntil      DateTime?
  nextStepText      String?
  nextStepAt        DateTime?
  lastLeadMessageAt DateTime?
  lastOutboundAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations Conversation[]
  hitlTasks     HitlTask[]
  requests      Request[]
  adminDecisionLogs AdminDecisionLog[]
  mediaAssets   MediaAsset[]
  stageEvents   LeadStageEvent[]
  notes         LeadNote[]

  @@unique([tenantId, channelId, externalUserId])
  @@index([tenantId])
  @@index([tenantId, attentionReason, attentionAt])
  @@index([tenantId, pipelineStage, updatedAt])
}

model Conversation {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId           String
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channelId        String
  channel          ChannelConnection @relation(fields: [channelId], references: [id], onDelete: Cascade)
  agentId          String
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status           String   @default("open")
  flowState        String
  flowVersion      Int
  /** Ephemeral per-thread state (booking_flow, drafts). Dies with the conversation. */
  session          Json     @default("{}")
  /** Why this thread opened/closed: idle | admin | done | hitl_resume | approve | inbound_create | … */
  lifecycleReason  String   @default("")
  nudgeCountByStage Json    @default("{}")
  summary          String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  messages  Message[]
  hitlTasks HitlTask[]
  requests  Request[]

  @@index([tenantId])
  @@index([leadId])
}

model Message {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role               String
  text               String   @default("")
  providerMessageId  String
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())

  @@unique([tenantId, providerMessageId])
  @@index([conversationId, createdAt])
}

/**
 * One structured commitment awaiting human approval - a visit, a stay, a fitting,
 * a rental. Verticals differ only in their `kind`, whether the time spine is a point
 * or a span, and the typed values in `data`; they are not separate tables.
 *
 * The time dimension stays normalized so the calendar and conflict queries work;
 * everything else is typed config (see `src/lib/flow/fields`).
 */
model Request {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /** Capability that owns this request: "booking" | "reservations" | … */
  capabilityId   String
  /** Tenant-facing kind: "visit" | "stay" | "fitting" | "rental" - a CapabilityInstance id. */
  kind           String
  status         String    @default("pending")
  /** Normalized time spine: a point in time sets startAt only; a span sets both. */
  startAt        DateTime?
  endAt          DateTime?
  /** Original human wording, e.g. "Thursday evening". Authoritative for display. */
  timeText       String    @default("")
  contactName    String    @default("")
  contactEmail   String    @default("")
  contactPhone   String    @default("")
  /** Typed field values per the instance's field schema (need, guests, unit, size, …). */
  data           Json      @default("{}")
  /** Set only when a configured rate source produced a quote. */
  quotedTotal    Float?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status, startAt])
  @@index([tenantId, kind, status])
  @@index([leadId])
  @@index([conversationId])
}

/**
 * A throwaway tenant spun up from zapidly.com. No Clerk org and no admin.
 * WhatsApp for the shared Zapidly number is routed here by `code` / `boundPhone`.
 */
model RapidDemo {
  id          String    @id @default(cuid())
  code        String    @unique
  /** draft | provisioning | active | expired */
  status      String    @default("draft")
  tenantId    String?   @unique
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  websiteHost String    @default("")
  ipHash      String    @default("")
  browserId   String    @default("")
  knowledgeMd String    @default("")
  extract     Json      @default("{}")
  expiresAt   DateTime?
  boundPhone  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([ipHash, createdAt])
  @@index([browserId, createdAt])
  @@index([websiteHost, status])
  @@index([boundPhone, status])
  // Partial unique indexes live only in
  // prisma/migrations/20261015120000_rapid_demo/migration.sql:
  // RapidDemo_one_active_ip, RapidDemo_one_active_browser
  // (status = 'active' AND the identity column <> '').
  // Prisma cannot model that WHERE clause. Against staging, with both indexes
  // present and the migration applied, `prisma migrate diff` was empty, so
  // db:verify does not special-case them. If a future Prisma version emits
  // DROP INDEX for those two names, delete those lines from the migration.
}

/**
 * Append-only log of admin (and customer) decisions of any kind.
 * `request` covers every approval vertical; HITL / lead actions use the same table.
 */
model AdminDecisionLog {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversationId String?
  /** Domain: request | hitl | lead | … */
  category       String
  /** Action within category: approve | decline | reschedule | … */
  action         String
  actorUserId    String
  actorLabel     String   @default("")
  /** Type-specific payload (note, customReply, requestId, kind, times, …). */
  details        Json     @default("{}")
  summary        String   @default("")
  createdAt      DateTime @default(now())

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, category, createdAt])
}

model HitlTask {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           String
  reason         String
  payload        Json      @default("{}")
  status         String    @default("open")
  resolution     Json?
  completedBy    String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([tenantId, status])
}

model MediaAsset {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  providerId  String
  storageUrl  String?
  analysis    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

/** Append-only stage history. Source of the activity timeline and future reports. */
model LeadStageEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  from        String
  to          String
  /** auto | manual */
  source      String
  reason      String   @default("")
  actorUserId String?
  createdAt   DateTime @default(now())

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, to, createdAt])
}

/** Internal note on a lead. Never shown to the customer. */
model LeadNote {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorUserId String
  authorLabel  String   @default("")
  body         String
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, leadId])
}

/** Staff member who opted in to the WhatsApp daily digest. */
model DigestRecipient {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clerkUserId    String
  label          String    @default("")
  /** Digits with country code, taken from the WhatsApp sender when the owner confirms. */
  phone          String
  optedInAt      DateTime?
  /** One-time `START <code>` the owner sends to the platform number to confirm the phone. */
  optInCode      String?   @unique
  optInCodeAt    DateTime?
  /** Zernio conversation on the platform number, for free-text sends inside the window. */
  conversationId String    @default("")
  /** Owner's last message to the platform number - opens WhatsApp's 24h window. */
  lastInboundAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, clerkUserId])
  // Partial unique index in
  // prisma/migrations/20261021120000_digest_phone_unique/migration.sql:
  // DigestRecipient_phone_opted_in_key (one opted-in business per phone).
  // Prisma cannot model the WHERE clause; see the RapidDemo note above.
}

/** One row per tenant per local day - the idempotency guard for the digest. */
model DigestLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /** YYYY-MM-DD in the tenant timezone. */
  date       String
  sentAt     DateTime @default(now())
  recipients Json     @default("[]")
  itemCount  Int      @default(0)

  @@unique([tenantId, date])
}

/**
 * The tenant owner's acceptance of the service agreement (הסכם ההתקשרות), one row per
 * tenant per agreement version. No FK on purpose: the record is contract evidence and
 * must outlive the tenant row (kept 7 years, annex B ב.11).
 */
model AgreementAcceptance {
  id          String   @id @default(cuid())
  tenantId    String
  version     String
  clerkUserId String
  email       String   @default("")
  ip          String   @default("")
  userAgent   String   @default("")
  acceptedAt  DateTime @default(now())

  @@unique([tenantId, version])
}

/// Per-environment inbound gate for one Zernio sender.
/// Production: a row pauses that sender. Other Vercel deploys: a row allows that sender.
/// Local dev ignores the table and handles everyone.
model ZernioSenderGate {
  senderKey String   @id
  createdAt DateTime @default(now())
}
